# Expo Mobile Application Environment Variables

# Supabase Project Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Diabetic Retinopathy Flask AI Backend URL
# Local development on simulator/emulator:
# - iOS Simulator: http://127.0.0.1:5000
# - Android Emulator: http://10.0.2.2:5000
# - Physical Device on Wi-Fi: http://192.168.100.4:5000
EXPO_PUBLIC_INFERENCE_API_URL=http://127.0.0.1:5000

# SECURITY NOTE:
# Never put GEMINI_API_KEY in this mobile .env file or any EXPO_PUBLIC_* variable.
# The Gemini API key is configured strictly on the backend server in s:\unimate\diabetic\.env
