# Diabetic Retinopathy API Environment Variables

# Service Port
PORT=5000

# Path to the trained Keras model artifact
RETINA_MODEL_PATH=retfound_model.keras

# Supabase Auth Secret
# Obtain from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
# If left empty, API operates in development mode (token verification bypassed)
SUPABASE_JWT_SECRET=

# Gunicorn concurrency settings (Production container)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
LOG_LEVEL=info

# Google Gemini API - Fundus Image Pre-validation Gate
# Secure server-side API Key (obtain from https://aistudio.google.com/)
# NEVER expose this key in client-side code or EXPO_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ENABLE_GEMINI_VALIDATION=true
GEMINI_TIMEOUT_SECONDS=15
